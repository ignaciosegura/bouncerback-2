{
  "name": "bouncerback",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "vite build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "build:android-install": "npm run cap:sync && cd android && ./gradlew installDebug",
    "cap:assets": "capacitor-assets generate --ios --android --assetPath assets/native --iconBackgroundColor \"#000000\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#000000\" --splashBackgroundColorDark \"#000000\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy:ftp": "node --env-file=.env.ftp scripts/deploy-ftp.js",
    "deploy:ftp:test": "node --env-file=.env.ftp scripts/deploy-ftp.js --test"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "howler": "^2.2.4",
    "lottie-web": "^5.13.0",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-react": "^6.1.1",
    "basic-ftp": "^6.2.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
