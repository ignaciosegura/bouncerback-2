{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LevelFile",
    "type": "object",
    "required": [
        "name",
        "duration",
        "timeSignature",
        "soundTrack",
        "atoms",
        "paddles",
        "lives"
    ],
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the level."
        },
        "duration": {
            "type": "number",
            "description": "Length of the level measured in bars."
        },
        "timeSignature": {
            "type": "object",
            "required": [
                "bpm",
                "signature"
            ],
            "properties": {
                "bpm": {
                    "type": "number",
                    "description": "Beats per minute."
                },
                "signature": {
                    "type": "number",
                    "description": "Beat count per bar (e.g., 4 for common time)."
                }
            },
            "additionalProperties": false
        },
        "soundTrack": {
            "type": "string",
            "description": "Filename of the audio file."
        },
        "vfx": {
            "type": "array",
            "description": "Visual-effects timeline entries. If empty, the default vfx will be used.",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "time"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Effect identifier."
                    },
                    "time": {
                        "type": "number",
                        "description": "Bar offset at which the effect triggers."
                    }
                },
                "additionalProperties": false
            },
            "default": []
        },
        "atoms": {
            "type": "object",
            "required": [
                "travelTime",
                "barsInterval"
            ],
            "properties": {
                "travelTime": {
                    "type": "number",
                    "description": "Beats required for an atom to travel from the atom emitter to the containment ring."
                },
                "barsInterval": {
                    "type": "number",
                    "description": "Spawn interval in bars: an atom can only appear once every X bars, at a random moment inside each interval."
                }
            },
            "additionalProperties": false
        },
        "paddles": {
            "type": "object",
            "required": [
                "angle",
                "duration"
            ],
            "properties": {
                "angle": {
                    "type": "number",
                    "description": "Arc length (width) of the paddle, measured in degrees. Suggested starting value: 30."
                },
                "duration": {
                    "type": "number",
                    "description": "Duration of the paddle action measured in seconds, counted from the moment the paddle is set (pointer released). Suggested starting value: 3."
                }
            },
            "additionalProperties": false
        },
        "lives": {
            "type": "integer",
            "description": "Number of lives the player starts the level with."
        }
    },
    "additionalProperties": false
}